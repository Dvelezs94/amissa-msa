# PostgreSQL (local Compose: postgresql://msa:msa@localhost:5432/msa)
DATABASE_URL=postgresql://msa:msa@localhost:5432/msa

SESSION_SECRET=change-me-in-production-min-32-chars

# Optional: for AI assistant (Asistente). Get key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: cap connections (default 10)
# PG_POOL_MAX=10

# Optional: SMTP for workflow email actions (Flujos)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=MSA <noreply@example.com>
#
# Gmail / Google Workspace: create an App Password at
# https://myaccount.google.com/apppasswords (2-Step Verification must be on).
# SMTP_PROVIDER=gmail
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=MSA <you@gmail.com>

# Optional: Telegram for workflow actions (Flujos). Token stays on the server.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=-1001234567890

# S3 / Object Storage (required for file uploads)
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=amissa-files
S3_ACCESS_KEY_ID=access-key-id
S3_SECRET_ACCESS_KEY=secret-access-key
S3_PUBLIC_BASE_URL=https://amissa-files.s3.us-east-1.amazonaws.com
# Optional: set to 1 for path-style S3 endpoints (e.g., MinIO)
# S3_FORCE_PATH_STYLE=1
